# Flood Center web v2 — copy to .env.local
# Target project: floodcenter-backend-v2 (never production floodcenter-backend;
# the app refuses to start if REACT_APP_FIREBASE_PROJECT_ID=floodcenter-backend)

REACT_APP_DEBUG_MODE=false

# Set to true to require Google sign-in (Firebase Auth) before the map loads.
REACT_APP_REQUIRE_LOGIN=false

# Firebase (public web config from Firebase console → Project settings → Your apps)
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=floodcenter-backend-v2.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=floodcenter-backend-v2
REACT_APP_FIREBASE_STORAGE_BUCKET=floodcenter-backend-v2.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=

# Google Maps (map ID must be a vector map ID for advanced markers;
# leave blank to use Google's DEMO_MAP_ID during development)
REACT_APP_GOOGLE_MAPS_API_KEY=
REACT_APP_GOOGLE_MAPS_ID=
REACT_APP_DEFAULT_MAP_LAT=37.715323
REACT_APP_DEFAULT_MAP_LNG=-122.493728
